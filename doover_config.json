    "analog_rain_gauge_dashboard": {
        "name": "analog_rain_gauge_dashboard",
        "display_name": "Rainfall Dashboard",
        "type": "PRO",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Farm dashboard aggregating every Analog Rain Gauge it can see - farm average / wettest / driest, a per-gauge table, rainfall-over-time, and an interpolated rainfall heatmap over a satellite basemap.",
        "long_description": "README.dashboard.md",
        "depends_on": [],
        "organisation_id": null,
        "image_name": null,
        "build_args": null,
        "staging_config": {
            "lambda_config": {
                "Environment": {
                    "Variables": {
                        "DOOVER_DATA_ENDPOINT": "https://data.staging.udoover.com/api"
                    }
                },
                "Runtime": "python3.13",
                "Timeout": 300,
                "Handler": "src.analog_rain_gauge_dashboard.handler",
                "MemorySize": 128,
                "Architectures": [
                    "arm64"
                ]
            }
        },
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
