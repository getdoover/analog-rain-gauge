                    "description": "Give Permission to access devices.",
                    "x-position": 0,
                    "properties": {
                        "devices": {
                            "title": "Devices",
                            "x-name": "devices",
                            "x-hidden": false,
                            "type": "array",
                            "x-required": true,
                            "description": "List of devices to grant extended permissions to.",
                            "x-position": 1,
                            "items": {
                                "title": "Device",
                                "x-name": "device",
                                "x-hidden": false,
                                "format": "doover-resource-device",
